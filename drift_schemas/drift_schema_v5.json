  "fixed_sql": [
    {
      "name": "games",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"games\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"player_count\" INTEGER NOT NULL, \"composition_json\" TEXT NULL, \"status\" INTEGER NOT NULL DEFAULT 0, \"session_json\" TEXT NULL, \"winner\" INTEGER NULL, \"ended_at\" INTEGER NULL, \"reserve_roles_json\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "players",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"players\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"game_id\" INTEGER NOT NULL REFERENCES games (id) ON DELETE CASCADE, \"seat_index\" INTEGER NOT NULL, \"name\" TEXT NOT NULL DEFAULT '', \"role_id\" TEXT NULL, \"alive\" INTEGER NOT NULL DEFAULT 1 CHECK (\"alive\" IN (0, 1)), UNIQUE (\"game_id\", \"seat_index\"));"
        }
      ]
    },
    {
      "name": "night_log",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"night_log\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"game_id\" INTEGER NOT NULL REFERENCES games (id) ON DELETE CASCADE, \"seq\" INTEGER NOT NULL, \"phase_label\" TEXT NOT NULL, \"icon_name\" TEXT NOT NULL, \"line\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
